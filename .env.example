NODE_ENV=development
PORT=3000
ORDERSEAL_DB_PATH=./data/orderseal.db
ORDERSEAL_ADMIN_TOKEN=replace-with-at-least-24-random-characters
ORDERSEAL_SIGNING_SECRET=replace-with-at-least-32-random-characters
